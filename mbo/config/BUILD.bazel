load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "int_flag")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load(":internal/config.bzl", "config_gen")

# Create custom bazel flag `--//mbo/config:limited_ordered_max_unroll_capacity`.
int_flag(
    name = "limited_ordered_max_unroll_capacity",
    build_setting_default = 16,
    visibility = ["//visibility:private"],
)

# Create custom bazel flag `--//mbo/config:require_throws`.
bool_flag(
    name = "require_throws",
    build_setting_default = False,
    visibility = ["//visibility:private"],
)

config_setting(
    name = "require_throws_enabled",
    flag_values = {":require_throws": "true"},
    visibility = ["//mbo:__subpackages__"],
)

bzl_library(
    name = "config_bzl",
    srcs = [":internal/config.bzl"],
    visibility = ["//visibility:private"],
    deps = ["@bazel_skylib//rules:common_settings"],
)

config_gen(
    name = "config_gen",
    output = "config_gen.h",
    template = "internal/config.h.in",
    visibility = ["//visibility:private"],
)

cc_library(
    name = "config_cc",
    hdrs = [
        "config.h",
        "config_gen.h",
    ],
    visibility = ["//mbo:__subpackages__"],
)

cc_test(
    name = "config_test",
    size = "small",
    srcs = ["config_test.cc"],
    deps = [
        ":config_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "require_cc",
    hdrs = ["require.h"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":config_cc",
        "@abseil-cpp//absl/log:absl_log",
    ],
)

cc_test(
    name = "require_test",
    size = "small",
    srcs = ["require_test.cc"],
    deps = [
        ":config_cc",
        ":require_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
