#!/usr/bin/env bash

# --- begin runfiles.bash initialization v3 ---
# Locate the Bash runfiles library so the hermetic llvm-symbolizer can be found by
# its runfiles path (stable across LLVM re-fetches) rather than a baked absolute path.
set -uo pipefail
f=bazel_tools/tools/bash/runfiles/runfiles.bash
# shellcheck disable=SC1090
source "${RUNFILES_DIR:-/dev/null}/$f" 2>/dev/null ||
  source "$(grep -sm1 "^$f " "${RUNFILES_MANIFEST_FILE:-/dev/null}" | cut -f2- -d' ')" 2>/dev/null ||
  source "$0.runfiles/$f" 2>/dev/null ||
  source "$(grep -sm1 "^$f " "$0.runfiles_manifest" | cut -f2- -d' ')" 2>/dev/null ||
  source "$(grep -sm1 "^$f " "$0.exe.runfiles_manifest" | cut -f2- -d' ')" 2>/dev/null ||
  RUNFILES_LIB_MISSING=1
# The library is only NEEDED to resolve a baked rlocation; the "auto" build finds a
# system symbolizer (or none) without it, so its absence is not an error here.
# --- end runfiles.bash initialization v3 ---

# Under --config=clang the genrule bakes the RUNFILES path of the hermetic
# llvm-symbolizer (an rlocation string), which the runfiles library resolves inside
# THIS wrapper's runfiles. That path is relative to the runfiles tree, not the
# repository cache, so it stays valid even when the LLVM toolchain is re-fetched to
# a new location each run - the failure mode of a baked `readlink -f` absolute path.
# The default (non-clang) build bakes "auto" and falls back to a system symbolizer.
SYMBOLIZER_RLOCATION="%%SYMBOLIZER_RLOCATION%%"

if [[ "${SYMBOLIZER_RLOCATION}" == "auto" ]]; then
  if [[ -z "${LLVM_SYMBOLIZER_PATH:-}" ]]; then
    for LOC in \
      "$(command -v llvm-symbolizer 2>/dev/null)" \
      /usr/local/bin/llvm-symbolizer \
      /usr/bin/llvm-symbolizer \
      /opt/homebrew/opt/llvm/bin/llvm-symbolizer; do
      if [[ -n "${LOC}" ]] && [[ -x "${LOC}" ]]; then
        export LLVM_SYMBOLIZER_PATH="${LOC}"
        break
      fi
    done
  fi
else
  if [[ -n "${RUNFILES_LIB_MISSING:-}" ]]; then
    echo "Cannot resolve baked llvm-symbolizer: bash runfiles library not found." 1>&2
    exit 1
  fi
  LLVM_SYMBOLIZER_PATH="$(rlocation "${SYMBOLIZER_RLOCATION}")"
  export LLVM_SYMBOLIZER_PATH
fi

if [[ -z "${LLVM_SYMBOLIZER_PATH:-}" ]] || ! [[ -x "${LLVM_SYMBOLIZER_PATH}" ]]; then
  if [[ "${SYMBOLIZER_RLOCATION}" == "auto" ]]; then
    # No system symbolizer (gcc CI runners ship none). A sanitizer report then
    # prints raw addresses - degraded, not broken - so run anyway. This is the
    # behaviour the old script had by ACCIDENT: its not-found handler called an
    # undefined `die`, printing "die: command not found" and carrying on.
    echo "WARNING: no llvm-symbolizer found; sanitizer reports will be unsymbolized." 1>&2
  else
    # The baked runfiles path was configured and MUST resolve; its absence means
    # the toolchain is broken, not merely missing a nicety.
    echo "Cannot resolve baked llvm-symbolizer: '${LLVM_SYMBOLIZER_PATH:-}'." 1>&2
    exit 1
  fi
else
  export ASAN_SYMBOLIZER_PATH="${LLVM_SYMBOLIZER_PATH}"
  export TSAN_SYMBOLIZER_PATH="${LLVM_SYMBOLIZER_PATH}"
  # MSan needs its own variable; without it a MemorySanitizer report is a list of
  # raw addresses, unusable for triage.
  export MSAN_SYMBOLIZER_PATH="${LLVM_SYMBOLIZER_PATH}"
fi

BIN="$(realpath "${PWD}/${1}")"

if [[ -x "$(command -v dsymutil 2>/dev/null)" ]]; then
  dsymutil "${BIN}"
fi

exec "$@"
