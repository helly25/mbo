# To debug bazel options, uncomment next line.
# common --announce_rc

# Allow platform specific control and add the missing 'CoreFoundation' lib.
common --enable_platform_specific_config

# Define the Apple OS
common --apple_platform_type=macos
common:macos --features=-macos_default_link_flags
common:macos --features=-supports_dynamic_linker
common:macos --linkopt=-framework --linkopt=CoreFoundation --host_linkopt=-framework --host_linkopt=CoreFoundation
common:macos --linkopt=-Wl,-undefined,dynamic_lookup --host_linkopt=-Wl,-undefined,dynamic_lookup
# Earliest arm64 macOS; also clears libc++'s std::filesystem availability gate.
common:macos --cxxopt=-mmacosx-version-min=11.0 --host_cxxopt=-mmacosx-version-min=11.0
common:macos --linkopt=-mmacosx-version-min=11.0 --host_linkopt=-mmacosx-version-min=11.0

try-import %workspace%/.bazelrc.user

common --consistent_labels
common --enable_bzlmod --noenable_workspace
common --incompatible_disallow_empty_glob
common --nolegacy_external_runfiles
common --features=layering_check,parse_headers

# Define absl=1 to tell googletest to use absl for backtrace.
common --define absl=1

common --cxxopt=-std=c++20 --host_cxxopt=-std=c++20 --cxxopt=-Werror

# Own the warning SET, not just the escalation: -Wall -Wextra explicitly, so the
# first-party bar does not depend on which toolchain's defaults happen to apply.
# missing-field-initializers is the one -Wextra class suppressed: designated init
# relying on defaulted trailing fields is this repo's deliberate idiom.
common --cxxopt=-Wall --host_cxxopt=-Wall
common --cxxopt=-Wextra --host_cxxopt=-Wextra
common --cxxopt=-Wno-missing-field-initializers --host_cxxopt=-Wno-missing-field-initializers
common:clang --cxxopt=-Wno-missing-designated-field-initializers
common:clang --host_cxxopt=-Wno-missing-designated-field-initializers
# -Wpedantic with two carve-outs, both absl macros expanding in our TUs
# (ABSL_FLAG's __COUNTER__; ABSL_CHECK's _Nullable). Plain `common`, not
# config-scoped: any clang - hermetic, system, bcr cells - needs them, and gcc
# silently tolerates unknown -Wno-* flags. Our own deliberate GNU statement
# expressions are annotated in code (__extension__ in decompose_count.h) instead.
common --cxxopt=-Wpedantic --host_cxxopt=-Wpedantic
common --cxxopt=-Wno-c2y-extensions --host_cxxopt=-Wno-c2y-extensions
common --cxxopt=-Wno-nullability-extension --host_cxxopt=-Wno-nullability-extension

# Keep -Werror first-party only: external headers become -isystem, external sources drop -Werror.
common --features=external_include_paths
common --per_file_copt=external/.*@-Wno-error

test --test_output=errors

common --copt=-fdiagnostics-color=always
common --copt=-fno-exceptions

# Hermetic LLVM only under this config; registering it unconditionally would hijack gcc/native builds.
common:clang --extra_toolchains=@llvm_toolchain_llvm//:all
common:clang --//mbo/mope:clang_format=
common:clang --cxxopt=-gmlt
common:clang --host_cxxopt=-gmlt
common:clang --linkopt=-fuse-ld=lld
common:clang --host_linkopt=-fuse-ld=lld
common:clang --define is_clang=true

# Named config the compile DB is generated in (compile_commands-update.sh). Adds no
# flags: the toolchain handles libc++ itself (see git_override in bazelmod/llvm.MODULE.bazel).
common:clang-tidy --config=clang

# Per-machine benchmark tuning configs, opt-in for measurement runs (see
# mbo/hash/measurements/README.md). A published dataset must be built for the
# machine it runs on: without -march/-mcpu the benchmark measures generic
# codegen, which understates SIMD-heavy competitors (xxh3 +27% at 1 KiB under
# znver5) and can hide target-specific pathologies (mumbo is 2x SLOWER under
# clang znver5 at >= 1 KiB). Never fold these into a default: the flag must be
# an explicit, recorded axis of the dataset (`--config` lands in the context).
# Add an `opt_<machine>` entry here when a new machine joins the measurement
# pool; prefer an explicit -march/-mcpu over -march=native so the dataset
# records WHAT was targeted, not just that something was.
common:opt_zen5 --copt=-march=znver5
common:opt_apple_m5 --copt=-mcpu=apple-m5

common:symbolizer --strip=never
common:symbolizer --run_under=//tools:run_under_symbolizer

# Custom --config=asan mode:
common:asan --config=symbolizer
common:asan --copt -g
common:asan --copt -fsanitize=address
common:asan --copt -fno-sanitize=vptr
common:asan --copt -fno-omit-frame-pointer
common:asan --copt -DADDRESS_SANITIZER
common:asan --linkopt -fsanitize=address
common:asan --linkopt -fno-sanitize=vptr
#common:asan --linkopt -fsanitize-link-c++-runtime
common:asan --linkopt -ldl
common:asan --define tcmalloc=disabled
common:asan --define signal_trace=disabled
common:asan --build_tag_filters=-no_san  # skip san targets
common:asan --test_tag_filters=-no_san  # skip san targets
common:asan --define san=true  # skip san targets
common:asan --features=asan  # https://github.com/bazelbuild/bazel/issues/6932
common:asan --action_env=ASAN_OPTIONS=halt_on_error=1:print_stacktrace=1:symbolize=1:strip_path_prefix=/proc/self/cwd/:color=always
common:asan --action_env=UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1:symbolize=1:strip_path_prefix=/proc/self/cwd/:color=always
common:asan --test_env=ASAN_OPTIONS=halt_on_error=1:print_stacktrace=1:symbolize=1:strip_path_prefix=/proc/self/cwd/:color=always
common:asan --test_env=UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1:symbolize=1:strip_path_prefix=/proc/self/cwd/:color=always

common:cpp23 --cxxopt=-std=c++23 --host_cxxopt=-std=c++23

try-import %workspace%/.bazelrc.user.end
