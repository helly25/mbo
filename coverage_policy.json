{
  "include": ["mbo/**"],
  "exclude": [
    "mbo/**/*_benchmark.cc",
    "mbo/**/*_fuzz_test.cc",
    "mbo/**/*_test.cc",
    "mbo/**/*_test.h"
  ],
  "minimum": { "lines": 90, "functions": 90, "branches": 75 },
