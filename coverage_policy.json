    },
    "hash": {
      "include": ["mbo/hash/**"],
      "minimum": { "lines": 98, "functions": 99, "branches": 39 }
    },
    "json": {
      "include": ["mbo/json/**"],
      "minimum": { "lines": 87, "functions": 54, "branches": 53 }
